min + 1)) + min;\n    }\n\n    /**\n     * Pick a random number from a list of numbers using matching weights\n     */\n    //% block=\"pick random number from $numbers with weights $weights\"\n    //% weight=33\n    export function pickWeightedNumber(numbers: number[], weights: number[]): number {\n        let total = 0;\n        for (let w of weights) {\n            total += w;\n        }\n        let roll = Math.random() * total;\n        for (let i = 0; i < weights.length; i++) {\n            roll -= weights[i];\n            if (roll <= 0) {\n                return numbers[i];\n            }\n        }\n        return numbers[numbers.length - 1];\n    }\n}\n"}]},{"timestamp":1795197532624,"editorVersion":"4.1.28","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":23885,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"g:^*bNe)RG7U#rxe,ywj\">mySprite</variable><variable type=\"KIND_SpriteKind\" id=\"oRq*YGlvc~HFQviLcLLv\">Player</variable><variable type=\"KIND_SpriteKind\" id=\"tsjp~cP9Q@pZ!ii|F]^q\">Projectile</variable><variable type=\"KIND_SpriteKind\" id=\"?^NKt`,=LvS{*$VE9*@m\">Food</variable><variable type=\"KIND_SpriteKind\" id=\"BbaZ=hj.bKm,MEitIuft\">Enemy</variable></variables><block type=\"custom_set_builtin_palette\" disabled-reasons=\"pxt_automatic_disabled\" x=\"20\" y=\"20\"><field name=\"palette\">BuiltInPalette.Original</field></block><block type=\"info_Countdown\" disabled-reasons=\"pxt_automatic_disabled\" x=\"405\" y=\"20\"><field name=\"type\">infoType.Score</field><value name=\"n\"><shadow type=\"toggleOnOff\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"on\">true</field></shadow></value></block><block type=\"info_displayCountdown\" disabled-reasons=\"pxt_automatic_disabled\" x=\"731\" y=\"20\"><value name=\"n\"><shadow type=\"toggleOnOff\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"on\">true</field></shadow></value></block><block type=