tion(sprite.x + X, sprite.y + Y);\n    }\n}\n","betterScene.ts":"\n/**\n* Use this file to define custom functions and blocks.\n* Read more at https://arcade.makecode.com/blocks/custom\n*/\n\nenum BuiltInPalette {\n    //% block=\"Original\"\n    Original,\n    //% block=\"Grayscale\"\n    Grayscale,\n    //% block=\"Adventure\"\n    Adventure,\n    //% block=\"Matte\"\n    Matte,\n    //% block=\"Pastel\"\n    Pastel,\n    //% block=\"Adafruit\"\n    Adafruit,\n    //% block=\"SteamPunk\"\n    SteamPunk,\n    //% block=\"Black & White\"\n    BlackAndWhite,\n    //% block=\"Poke\"\n    Poke\n}\n\n\nnamespace scene {\n\n    const palettes: { [key: number]: Buffer } = {\n        [BuiltInPalette.Original]: hex`000000ffffff ff2121ff93c4ff8135fff609249ca378dc52003fad87f2ff8e2ec891463d5c406ce5cdc4919191000000`,\n        [BuiltInPalette.Grayscale]: hex`000000ffffff545454a8a8a8808080dfdfdf727272bdbdbd353535c9c9c9565656939393373737bcbcbc7d7d7d000000`,\n        [BuiltInPalette.Adventure]: hex`000000faf6f0d13b27e6879beba422f7e4762d914275cc4a25517568b5d4423b618c4a2e402819b583595757570f0f0f`,\n        [BuiltInPalette.Matte]: hex`000000f5f5f5d9534ff08a5db83b5ef9ed69388e3c88d4982b58766eb5ff48466d7d5a503d3b40c5c5c57a7a7a1e1e1e`,\n        [BuiltInPalette.Pastel]: hex`000000fffdf9ff8b94ffaaa5ffcb91fff59d88d8b0b8e99f779ecba8d5f4b69fd6c48c8a726a5a52e2ded59e9a952d2a2e`,\n        [BuiltInPalette.Adafruit]: hex`000000ffffffe31c24ff6699ff8200ffd10000a85966cc33005eb866b2e83333999966cc663300d9d9d675787b000000`,\n        [BuiltInPalette.SteamPunk]: hex`000000f4ebd9a63a2bd4846a9c5a25d9a84e3e5940788c5e2736404d6c7a3b2833694a3d2b1d12b8a9916e6352140e0a`,\n        [BuiltInPalette.BlackAndWhite]: hex`000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff000000000000000000`,\n        [BuiltInPalette.Poke]: hex`000000f8f8f8d83828f88878e87820f8d84830884078d86830589878b8f8584888986848483828b8b8a8707068181818`\n    };\n    //% group=\"Screen\"\n    //% weight=24\n    //% blockId=custom_set_builtin_palette\n    //% block=\"set color palette to %palette\"\n    export function setBuiltInPalette(palette: BuiltInPalette): void {\n        const buf = palettes[palette];\n        if (buf) {\n            image.setPalette(buf);\n        }\n    }\n}\n","moreLogic.ts":"enum ExtraLogicOp {\n    //% block=\"xor\"\n    Xor,\n    //% block=\"xand\"\n    Xand\n}\n\nnamespace logic {\n\n    //% blockId=logic_extra_xand_op\n    //% block=\"$a $op $b\"\n    //% a.shadow=\"unset\"\n    //% b.shadow=\"unset\"\n    //% op.defl=ExtraLogicOp.Xand\n    //% group=\"Boolean\"\n    //% weight=85\n    export function extraXandGate(a: any, op: ExtraLogicOp, b: any): boolean {\n        return extraXorGate(a, op, b);\n    }\n\n\n    //% blockId=logic_extra_xor_op\n    //% block=\"$a $op $b\"\n    //% a.shadow=\"unset\"\n    //% b.shadow=\"unset\"\n    //% group=\"Boolean\"\n    //% weight=84\n    export function extraXorGate(a: any, op: ExtraLogicOp, b: any): boolean {\n        const boolA = !!a;\n        const boolB = !!b;\n        if (op === ExtraLogicOp.Xor) {\n            return boolA != boolB;\n        } else {\n            return boolA == boolB;\n        }\n    }\n}\n","MathPlus.ts":"namespace Math {\n    /**\n     * Pick a random number from min to max with a weight bias.\n     * bias > 1 favors higher numbers (closer to max).\n     * bias < 1 favors lower numbers (closer to min).\n     * bias = 1 is normal equal random.\n     */\n    //% block=\"pick random $min to $max with weight $bias\"\n    //% min.defl=0 max.defl=10 bias.defl=2\n    //% weight=34\n    export function pickWeightedRange(min: number, max: number, bias: number): number {\n        if (min > max) {\n            let temp = min;\n            min = max;\n            max = temp;\n        }\n        if (bias <= 0) bias = 1;\n\n        let r = Math.pow(Math.random(), 1 / bias);\n        return Math.floor(r * (max - min + 1)) + min;\n    }\n\n    /**\n     * Pick a random number from a list of numbers using matching weights\n     */\n    //% block=\"pick random number from $numbers with weights $weights\"\n    //% weight=33\n    export function pickWeightedNumber(numbers: number[], weights: number[]): number {\n        let total = 0;\n        for (let w of weights) {\n            total += w;\n        }\n        let roll = Math.random() * total;\n        for (let i = 0; i < weights.length; i++) {\n            roll -= weights[i];\n            if (roll <= 0) {\n                return numbers[i];\n            }\n        }\n        return numbers[numbers.length - 1];\n    }\n}\n","images.g.jres":"{\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myImages\"\n    }\n}","images.g.ts":"","pxt.json":"{\n    \"name\": \"More Info Settings - Test\",\n    \"description\": \"Adds some more features to the info tab that normally require using JavaScript\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"moreinfo.ts\",\n        \"tilemap.g.jres\",\n        \"tilemap.g.ts\",\n        \"extraBooleans.ts\",\n        \"moreSpriteTools.ts\",\n        \"betterScene.ts\",\n        \"moreLogic.ts\",\n        \"MathPlus.ts\",\n        \"images.g.jres\",\n        \"images.g.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\",\n    \"assetPack\": false\n}\n"}}],"shares":[{"id":"18076-21186-42470-42038","type":"permalink","timestamp":1795120748843},{"id":"11863-07340-26127-82555","type":"permalink","timestamp":1795197533014},{"id":"33522-73641-15058-25506","type":"snapshot","timestamp":1795198258944},{"id":"38527-44932-38152-59927","type":"permalink","timestamp":1795198326060},{"id":"68018-04857-81918-60779","type":"permalink","timestamp":1795200738979}],"lastSaveTime":1795210158007}